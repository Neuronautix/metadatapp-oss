{
    "name": "neuronautix/metadatapp-api",
    "description": "Symfony and API Platform backend for the Metadatapp FAIR metadata management platform.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Neuronautix",
            "homepage": "https://www.neuronautix.com"
        }
    ],
    "keywords": [
        "metadata",
        "fair-data",
        "api-platform",
        "biomedical-research",
        "laboratory-data"
    ],
    "homepage": "https://github.com/Neuronautix/metadatapp",
    "support": {
        "issues": "https://github.com/Neuronautix/metadatapp/issues",
        "source": "https://github.com/Neuronautix/metadatapp"
    },
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.3",
        "api-platform/graphql": "^4.3",
        "api-platform/mcp": "^4.3",
        "api-platform/symfony": "^4.3",
        "doctrine/common": "^3.4",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.1",
        "doctrine/persistence": "^3.4",
        "dragonmantank/cron-expression": "^3.6",
        "nelmio/cors-bundle": "^2.4",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpoffice/phpspreadsheet": "^3.10.6",
        "runtime/frankenphp-symfony": "^0.2.0",
        "symfony/asset": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "^8.0",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mcp-bundle": "^0.6",
        "symfony/mercure-bundle": "^0.3.8",
        "symfony/messenger": "^7.3",
        "symfony/monolog-bundle": "^3.10",
        "symfony/object-mapper": "^8.0",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-core": "^7.3",
        "symfony/serializer": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "web-token/jwt-bundle": "^4.0",
        "webonyx/graphql-php": "^15.32.3",
        "zenstruck/foundry": "^2.0"
    },
    "require-dev": {
        "api-platform/schema-generator": "^5.2.5",
        "dama/doctrine-test-bundle": "^8.0",
        "friendsofphp/php-cs-fixer": "^3.71",
        "justinrainbow/json-schema": "^6.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpdoc-parser": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.52",
        "symfony/stopwatch": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "bump-after-update": true,
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": false,
            "endpoint": [
                "https://api.github.com/repos/Spomky-Labs/recipes/contents/index.json?ref=main",
                "flex://defaults"
            ]
        }
    },
    "minimum-stability": "stable"
}
