parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
    excludePaths:
        - src/DataFixtures/*
        - src/ConnectedApps/State/*
        # Auto-generated by Symfony; its @psalm-type aliases (ConfigType, RoutesConfig) are
        # not resolvable by PHPStan, causing false-positive "mixed is not subtype of array" errors.
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        constantHassers: false
    scanDirectories:
        - var/cache/dev/Symfony/Config
    bootstrapFiles:
        - vendor/autoload.php
        - src/Kernel.php
    ignoreErrors:
        - message: '#no (?:return|value) type specified in iterable type array\.#'
        - '#implements generic interface ApiPlatform\\State\\ProcessorInterface but does not specify its types#'
        - '#has parameter \$innerProcessor with generic interface ApiPlatform\\State\\ProcessorInterface but does not specify its types#'
