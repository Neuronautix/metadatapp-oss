{
  "name": "e2e",
  "version": "1.0.0",
  "description": "Root-level E2E tests for Osoma with live API",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:osoma": "playwright test --project=osoma",
    "test:route-health": "playwright test --project=osoma tests/osoma/app-route-health.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.19.7",
    "jszip": "^3.10.1",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "e2e",
    "playwright",
    "api-platform"
  ]
}
