{
  "name": "osoma-metadatapp",
  "description": "React frontend for the Metadatapp FAIR metadata management platform.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.13.12",
  "type": "module",
  "author": "Neuronautix",
  "homepage": "https://github.com/Neuronautix/metadatapp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neuronautix/metadatapp.git",
    "directory": "osoma"
  },
  "bugs": {
    "url": "https://github.com/Neuronautix/metadatapp/issues"
  },
  "keywords": [
    "metadata",
    "fair-data",
    "react",
    "biomedical-research",
    "laboratory-data"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test:integration": "node scripts/run-vitest-integration.mjs",
    "test:integration:raw": "vitest run",
    "preview": "vite preview",
