    "openapi:types:dvc-proxy": "openapi-typescript ../api/public/docs.json -o src/domain/dvc/dvc-proxy.generated.ts",
    "openapi:types:official": "openapi-typescript osoma/resources/metadatapp.json -o src/metadatapp/openapi-types.ts"
  },
