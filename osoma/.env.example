# Public-safe example configuration for Osoma.
# Copy to osoma/.env.local and replace values as needed.

VITE_API_URL=https://metadatapp.test
VITE_SENSOR_API_URL=https://sensor.example.invalid
VITE_DATA_MODE=real
VITE_AUTH_MODE=real

# Published User & Integration Guide. The in-app Documentation page links here.
VITE_DOCS_URL=https://doc.metadatapp.net

VITE_OIDC_CLIENT_ID=osoma
VITE_OIDC_REALM=demo
VITE_OIDC_SERVER_URL=https://auth.metadatapp.test/oidc/realms/demo
VITE_OIDC_SERVER_URL_INTERNAL=https://auth.metadatapp.test/oidc/realms/demo

# Optional local operations mode code. Leave unset unless actively testing it.
# VITE_OPS_CODE=
